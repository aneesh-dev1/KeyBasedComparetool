# Settings for deploy.sh. "./deploy.sh setup" copies this to deploy.env with your hostname filled in.
# deploy.env is sourced as trusted shell configuration: keep it editable only by the service administrator.

# The exact address users open in the browser (hostname or IP, and port). 0.0.0.0 is not a browser address.
PUBLIC_URL="http://compare.internal:8765"
BIND_HOST="0.0.0.0"
PORT=8765

# Prefer absolute paths on a local SSD, writable by the account that runs the app.
# DATA_DIR="/srv/key-compare/data"
# RUN_DIR="/srv/key-compare/run"

# Python 3.9 or newer. By default the app's .venv (created by setup, with PyArrow for Parquet) is used,
# otherwise the newest python3.x on PATH. Set this only to force a specific interpreter.
# PYTHON_BIN="/usr/bin/python3.11"

# Comparisons that run at the same time. Empty: chosen from the CPU count (2 to 4); CPUs and memory are
# shared between them by input size, and further comparisons wait in a queue.
MAX_JOBS=
# Automatic RAM sizing without a fixed ceiling. An administrator may set an MB cap.
MAX_SORT_MB=0

# For HTTPS via an internal reverse proxy on the same server:
# PUBLIC_URL="https://compare.internal"
# BIND_HOST="127.0.0.1"

# Delete inactive jobs and all their files after 7 days; 0 disables automatic cleanup.
RETENTION_DAYS=7
# Delete the rebuildable mismatch-analysis index after 3 days unused; 0 keeps it.
ANALYSIS_RETENTION_DAYS=3

# Optional server source directories, one per line inside this quoted value.
# Files are read in place; originals are never deleted by cleanup.
SOURCE_ROOTS=""

# systemd service (./deploy.sh install-service). SERVICE_USER applies to a system service installed with
# sudo; it defaults to the owner of the application folder. Stopping waits this long for active comparisons.
# SERVICE_NAME="key-compare"
# SERVICE_USER="compare"
STOP_TIMEOUT_SECONDS=900
