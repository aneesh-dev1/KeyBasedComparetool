# Copy to deploy.env and edit. This file is sourced as trusted shell configuration.
PUBLIC_URL="http://compare.internal:8765"
BIND_HOST="0.0.0.0"
PORT=8765
# Prefer an absolute local SSD path writable by the Linux service account.
# DATA_DIR="/srv/key-compare/data"
# RUN_DIR="/srv/key-compare/run"
PYTHON_BIN="python3"
# Five browsers can upload independently. Expensive work queues at this limit.
MAX_JOBS=1
MAX_SORT_MB=4096
# For HTTPS via an internal reverse proxy:
# PUBLIC_URL="https://compare.internal"
# BIND_HOST="127.0.0.1"
